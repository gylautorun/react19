{
  "name": "react-19-lab",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:wasm": "asc src/wasm/lab.ts --outFile public/wasm/lab.wasm --optimize --runtime stub --noAssert && node scripts/copy-tf-wasm.mjs",
    "test:wasm": "node scripts/check-wasm.mjs",
    "predev": "npm run build:wasm",
    "prebuild": "npm run build:wasm",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint:code": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.scss\" --max-warnings=0",
    "lint:format": "prettier --check \"src/**/*.{ts,tsx,scss}\" \"scripts/*.{js,mjs}\" \"*.{js,mjs,cjs,ts}\"",
    "lint": "npm run lint:code && npm run lint:styles && npm run lint:format",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"scripts/*.{js,mjs}\" \"*.{js,mjs,cjs,ts}\"",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test:wasm",
    "precommit": "lint-staged --no-stash && npm run typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.5%",
    "not dead",
    "not IE 11",
    "Safari >= 14",
    "ios_saf >= 14"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --check",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{scss,css}": [
      "prettier --check",
      "stylelint --max-warnings=0"
    ]
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "lit": "^3.3.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "wasm-feature-detect": "1.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "assemblyscript": "0.28.20",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "rsc-html-stream": "^0.0.8",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
